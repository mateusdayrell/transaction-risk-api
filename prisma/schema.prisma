generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int   @id @default(autoincrement()) // String   @id @default(cuid())
  email     String   @unique
  password  String
  products  Product[]
  roles     Role[]
  // createdAt DateTime @default(now())
  // updatedAt DateTime @updatedAt
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  price       Float
  userId      Int
  user        User    @relation(fields: [userId], references: [id])
  image       String
  soldOut     Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  users       User[]
}
